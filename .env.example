# ==============================================================================
# NERAM: TEMPORARY SOCIAL PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Fill in the values for your local or production environment.
# 3. DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Supabase Configuration
# Required for authentication, database, realtime, and storage.
# The anon key is safe for public client distribution as it is constrained by Row Level Security (RLS).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# External Geospatial Services
# Vector tile endpoint (OpenFreeMap / self-hosted tile server)
EXPO_PUBLIC_MAP_TILE_URL=https://tiles.openfreemap.org/styles/bright
# Valhalla routing & map-matching endpoint (proxied or direct)
EXPO_PUBLIC_VALHALLA_API_URL=https://valhalla1.openstreetmap.de

# Monitoring & Crash Reporting
# Sentry DSN for native & JavaScript error tracking
EXPO_PUBLIC_SENTRY_DSN=

# App Environment Mode
# Values: development | staging | production
EXPO_PUBLIC_APP_ENV=development
